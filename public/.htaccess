# Copy dari folder public/ oleh Next.js static export (output: "export").
# Upload bersama isi out/ ke document root ads.impostmedia.com.

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Root diarahkan ke /klinik/ (menggantikan proxy.ts yang tidak jalan di static export)
  RewriteRule ^$ /klinik/ [R=301,L]

  # Paksa HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

ErrorDocument 404 /404.html
